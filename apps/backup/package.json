{
  "name": "backup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "with-env": "dotenv -e ../../.env --",
    "backup": "pnpm with-env tsx src/main.ts backup",
    "restore": "pnpm with-env tsx src/main.ts restore",
    "list": "pnpm with-env tsx src/main.ts list",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
