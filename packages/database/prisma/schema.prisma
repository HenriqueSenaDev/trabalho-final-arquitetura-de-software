generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Conta
// ---------------------------------------------------------------------------

model Holder {
  id        String    @id @default(uuid()) @db.Uuid
  fullName  String    @map("full_name")
  email     String    @unique
  password  String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  records    HealthRecord[]
  indicators Indicator[]
  reminders  Reminder[]
  sessions   Session[]

  @@map("holders")
}

// Sessão por aparelho (ADR 04): o servidor guarda só o hash do token. Revogar
// a sessão invalida o token e desassocia o destino de notificações.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  holderId      String    @map("holder_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  device        String    @db.VarChar(80)
  deliveryToken String?   @map("delivery_token") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")
  revokedAt     DateTime? @map("revoked_at")

  holder Holder @relation(fields: [holderId], references: [id])

  @@index([holderId, revokedAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Histórico
// ---------------------------------------------------------------------------

enum HealthRecordKind {
  CONSULTATION
  EXAM
  VACCINE
  PRESCRIPTION
  OTHER

  @@map("health_record_kind")
}

model HealthRecord {
  id          String           @id @default(uuid()) @db.Uuid
  holderId    String           @map("holder_id") @db.Uuid
  kind        HealthRecordKind
  title       String
  description String?
  occurredAt  DateTime         @map("occurred_at")
  // Campos de consulta (RF1.1): profissional, local e retorno vinculado.
  professional String?
  location     String?
  followUpAt   DateTime?       @map("follow_up_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  holder      Holder       @relation(fields: [holderId], references: [id])
  attachments Attachment[]

  @@index([holderId, occurredAt])
  @@map("health_records")
}

// Metadados do anexo; o binário fica no armazenamento de anexos.
model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  recordId   String   @map("record_id") @db.Uuid
  storageKey String   @unique @map("storage_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  record HealthRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Indicadores
// ---------------------------------------------------------------------------

model Indicator {
  id         String   @id @default(uuid()) @db.Uuid
  holderId   String   @map("holder_id") @db.Uuid
  type       String   @db.VarChar(60)
  value      Decimal  @db.Decimal(10, 2)
  unit       String   @db.VarChar(20)
  measuredAt DateTime @map("measured_at")
  createdAt  DateTime @default(now()) @map("created_at")

  holder Holder @relation(fields: [holderId], references: [id])

  @@index([holderId, type, measuredAt])
  @@map("indicators")
}

// ---------------------------------------------------------------------------
// Lembretes (agendamentos)
// ---------------------------------------------------------------------------

enum ReminderStatus {
  SCHEDULED
  CANCELLED
  DONE

  @@map("reminder_status")
}

model Reminder {
  id        String         @id @default(uuid()) @db.Uuid
  holderId  String         @map("holder_id") @db.Uuid
  // Consulta de origem, quando o lembrete é o aviso de uma consulta.
  recordId  String?        @unique @map("record_id") @db.Uuid
  title     String
  notes     String?
  remindAt  DateTime       @map("remind_at")
  status    ReminderStatus @default(SCHEDULED)
  // Reagendar ou cancelar gera uma nova versão; só a vigente é entregue (ADR 03).
  version   Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  holder        Holder                 @relation(fields: [holderId], references: [id])
  notifications NotificationDelivery[]

  @@index([holderId, remindAt])
  @@map("reminders")
}

// Aviso reservado pelo processador; entregue ao provedor de notificações.
enum NotificationStatus {
  RESERVED
  SENT
  FAILED
  CANCELLED

  @@map("notification_status")
}

model NotificationDelivery {
  id           String             @id @default(uuid()) @db.Uuid
  reminderId   String             @map("reminder_id") @db.Uuid
  // Versão do lembrete que este aviso entrega; lembrete + versão é a chave de deduplicação.
  version      Int                @default(1)
  scheduledFor DateTime           @map("scheduled_for")
  status       NotificationStatus @default(RESERVED)
  attempts     Int                @default(0)
  lastError    String?            @map("last_error")
  sentAt       DateTime?          @map("sent_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  reminder Reminder @relation(fields: [reminderId], references: [id])

  @@unique([reminderId, version])
  @@index([status, scheduledFor])
  @@map("notification_deliveries")
}

// ---------------------------------------------------------------------------
// Outbox de eventos (gravado na mesma transação da escrita de negócio)
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED

  @@map("outbox_status")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id") @db.Uuid
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  occurredAt    DateTime     @default(now()) @map("occurred_at")
  processedAt   DateTime?    @map("processed_at")

  @@index([status, occurredAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// Trilha de auditoria (ADR 04): identidade, ação, resultado e instante, sem
// conteúdo clínico. A referência é um identificador técnico.
// ---------------------------------------------------------------------------

enum AuditOutcome {
  SUCCESS
  DENIED
  REJECTED
  ERROR

  @@map("audit_outcome")
}

model AuditLog {
  id        String       @id @default(uuid()) @db.Uuid
  holderId  String?      @map("holder_id") @db.Uuid
  action    String       @db.VarChar(80)
  outcome   AuditOutcome
  reference String?      @db.VarChar(120)
  at        DateTime     @default(now())

  @@index([holderId, at])
  @@map("audit_logs")
}
