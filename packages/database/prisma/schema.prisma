// Banco relacional do PersonalHealth (contêiner "Banco relacional" do C4 nível 2).
//
// ADR 01: cada módulo do monólito é dono das suas tabelas, mesmo que todas
// morem no mesmo banco. Por isso não há chave estrangeira entre tabelas de
// módulos diferentes: um módulo só conhece o outro pelo identificador.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Módulo Acesso à Conta
// ---------------------------------------------------------------------------

model Titular {
  id        String   @id @db.Uuid
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  criadoEm  DateTime @default(now()) @map("criado_em")

  sessoes Sessao[]

  @@map("titulares")
}

// Uma sessão por aparelho. Revogar a sessão também desassocia o destino de
// notificações daquele aparelho (ADR 04).
model Sessao {
  id           String    @id @db.Uuid
  titularId    String    @map("titular_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  dispositivo  String
  tokenEntrega String?   @map("token_entrega")
  criadaEm     DateTime  @default(now()) @map("criada_em")
  revogadaEm   DateTime? @map("revogada_em")

  titular Titular @relation(fields: [titularId], references: [id])

  @@index([titularId])
  @@map("sessoes")
}

// ---------------------------------------------------------------------------
// Módulo Histórico
// ---------------------------------------------------------------------------

model Consulta {
  id            String    @id @db.Uuid
  titularId     String    @map("titular_id") @db.Uuid
  dataHora      DateTime  @map("data_hora") // data do acontecimento
  especialidade String
  profissional  String?
  local         String?
  motivo        String?
  anotacoes     String?
  retornoEm     DateTime? @map("retorno_em")
  registradaEm  DateTime  @map("registrada_em") // data de registro (campo distinto)

  @@index([titularId, dataHora, id])
  @@map("consultas")
}

// ---------------------------------------------------------------------------
// Módulo Lembretes (agendamento durável, ADR 03)
// ---------------------------------------------------------------------------

enum EstadoAgendamento {
  PENDENTE
  ENVIADO
  CANCELADO
  FALHOU

  @@map("estado_agendamento")
}

model Agendamento {
  id           String            @id @db.Uuid
  titularId    String            @map("titular_id") @db.Uuid
  origemTipo   String            @map("origem_tipo") // CONSULTA (ou ocorrência de dose, fora deste fluxo)
  origemId     String            @map("origem_id") @db.Uuid
  instante     DateTime
  estado       EstadoAgendamento @default(PENDENTE)
  versao       Int               @default(1) // reagendar ou cancelar invalida a versão anterior
  tentativas   Int               @default(0)
  reservadoAte DateTime?         @map("reservado_ate") // reserva do processador / espera até a próxima tentativa
  reserva      String?           @db.Uuid // qual reserva do processador detém o agendamento; só ela pode escrever
  ultimoErro   String?           @map("ultimo_erro")
  enviadoEm    DateTime?         @map("enviado_em")
  criadoEm     DateTime          @default(now()) @map("criado_em")
  atualizadoEm DateTime          @updatedAt @map("atualizado_em")

  @@unique([origemTipo, origemId])
  @@index([estado, instante])
  @@map("agendamentos")
}

model EventoOutbox {
  id           String    @id @db.Uuid
  tipo         String
  origemId     String    @map("origem_id") @db.Uuid
  titularId    String    @map("titular_id") @db.Uuid
  versao       Int
  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  processadoEm DateTime? @map("processado_em") @db.Timestamptz

  @@unique([tipo, origemId, versao])
  @@map("eventos_outbox")
}

// ---------------------------------------------------------------------------
// Trilha de auditoria (ADR 04): identidade, ação, resultado e instante,
// sem copiar conteúdo clínico.
// ---------------------------------------------------------------------------

model RegistroAuditoria {
  id         String   @id @default(uuid()) @db.Uuid
  identidade String?  @db.Uuid
  acao       String
  resultado  String
  referencia String?
  instante   DateTime @default(now())

  @@index([identidade, instante])
  @@map("auditoria")
}
