# Banco relacional (docker compose)
DATABASE_URL="postgresql://root:root@localhost:5432/personalhealth"

# API de Saúde
PORT="3000"

# Processador de lembretes (apps/worker)
LEMBRETES_INTERVALO_MS="2000"     # intervalo entre ciclos quando não há fila
LEMBRETES_LOTE="20"               # agendamentos reservados por ciclo
LEMBRETES_RESERVA_SEGUNDOS="60"   # quanto tempo uma réplica segura o agendamento reservado
LEMBRETES_MAX_TENTATIVAS="5"      # depois disso o agendamento fica FALHOU
LEMBRETES_ESPERA_BASE_SEGUNDOS="30" # espera antes de nova tentativa (dobra a cada falha)
PROVEDOR_NOTIFICACOES="console"   # console | http
PROVEDOR_NOTIFICACOES_URL=""
PROVEDOR_NOTIFICACOES_TOKEN=""
PROVEDOR_NOTIFICACOES_TEMPO_LIMITE_SEGUNDOS="10" # a reserva precisa durar pelo menos o dobro
