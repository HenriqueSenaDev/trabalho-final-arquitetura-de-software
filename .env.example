# Banco relacional
DATABASE_URL="postgresql://root:root@localhost:5432/personalhealth"

# API de Saúde
PORT="3000"
JWT_SECRET="change-me-access-secret"

# Armazenamento de anexos (S3 compatível, bucket privado)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET="personalhealth-attachments"
STORAGE_URL_TTL_SECONDS="300"

# Processador de eventos e lembretes
OUTBOX_POLL_INTERVAL_MS="2000"
OUTBOX_BATCH_SIZE="50"
OUTBOX_MAX_ATTEMPTS="5"
NOTIFICATION_PROVIDER="console" # console | http
NOTIFICATION_PROVIDER_URL=""
NOTIFICATION_PROVIDER_TOKEN=""

# Repositório de backup (instância isolada, cópias cifradas)
BACKUP_ENDPOINT="http://localhost:9100"
BACKUP_REGION="us-east-1"
BACKUP_ACCESS_KEY="backupadmin"
BACKUP_SECRET_KEY="backupadmin"
BACKUP_BUCKET="personalhealth-backups"
BACKUP_ENCRYPTION_KEY="" # 32 bytes em base64: openssl rand -base64 32
